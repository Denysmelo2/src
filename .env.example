# =====================================================================
# SnapGain — local environment template
# Copy to .env (which is gitignored) and fill in real values.
# =====================================================================

# ─── Supabase ─────────────────────────────────────────────────────────
# Currently the URL + anon key are hardcoded in src/lib/customSupabaseClient.js
# (the anon key is meant to be public). If you decide to env-ify them,
# uncomment these and update customSupabaseClient.js to read from
# import.meta.env.
#
# VITE_SUPABASE_URL=https://ffowgyjdbgkphsflxybk.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Stripe (frontend doesn't need any keys) ──────────────────────────
# We use server-side Stripe Checkout via the `create-checkout-session`
# Edge Function, so no Stripe keys live in the React bundle. All Stripe
# secrets go into Supabase Edge Function secrets — see SETUP_STRIPE.md.

# ─── Observability ────────────────────────────────────────────────────
# Both are optional — the app boots cleanly without them.
#
# Sentry: error tracking + perf monitoring. Get DSN from
#   https://sentry.io → Settings → Projects → snapgain → Client Keys.
#   Free tier covers 5k errors/month.
# VITE_SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX

# Google Analytics 4: only loads after the user accepts cookies via
# the CookieConsentBanner. Get ID from
#   https://analytics.google.com → Admin → Data Streams → Web.
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Environment label sent to Sentry + analytics ('production' | 'staging')
# VITE_APP_ENV=production

# ─── Site address for auth e-mail links ───────────────────────────────
# Where the password-reset and confirmation e-mails send people back to.
# In Vercel (Production) it is https://snapgain.uk. Leave it unset locally:
# the page's own address is used. A localhost value is ignored in a
# production build and stops the Vercel production build (vite.config.js).
# VITE_SITE_URL=https://snapgain.uk

# hCaptcha SITE key (a UUID; never the secret key). Required in Vercel
# Production: the production build stops without it.
# VITE_HCAPTCHA_SITE_KEY=00000000-0000-0000-0000-000000000000
