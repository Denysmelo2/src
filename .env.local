# Variáveis de ambiente para o frontend React
# Renomeie este arquivo para .env.local e configure com seus valores reais

# URL do seu projeto Supabase
VITE_SUPABASE_URL=https://ffowgyjdbgkphsflxybk.supabase.co

# Chave pública/anônima do Supabase
VITE_SUPABASE_ANON_KEY=sb_publishable_fG0AhiV3dznAp7DcHm5jPA_jepTG5-W

# URL base das Edge Functions (normalmente igual ao SUPABASE_URL + /functions/v1)
VITE_EDGE_FUNCTIONS_URL=https://ffowgyjdbgkphsflxybk.supabase.co/functions/v1

# ✅ EDGE FUNCTIONS IMPLANTADAS COM SUCESSO:
# - auth-callback: https://ffowgyjdbgkphsflxybk.supabase.co/functions/v1/auth-callback
# - user-registration: https://ffowgyjdbgkphsflxybk.supabase.co/functions/v1/user-registration
# - platform-comparison: https://ffowgyjdbgkphsflxybk.supabase.co/functions/v1/platform-comparison
# - subscription-handler: https://ffowgyjdbgkphsflxybk.supabase.co/functions/v1/subscription-handler


# Ambiente de desenvolvimento
VITE_APP_ENV=development

# URL da aplicação (para callbacks)
VITE_APP_URL=http://localhost:5173 

# hCaptcha SITE key (a UUID, from hCaptcha → Sites). Never the secret key (ES_…).
VITE_HCAPTCHA_SITE_KEY=

# Adicionar estas linhas no .env.local
VITE_SUPABASE_REDIRECT_URL=http://localhost:5173/auth/callback
VITE_SITE_URL=http://localhost:5173 

# Como obter essas informações:
# 1. Acesse o Supabase Dashboard (https://app.supabase.com)
# 2. Selecione seu projeto
# 3. Vá para Settings > API
# 4. Copie a URL do projeto e as chaves API
# 5. Substitua os valores acima pelos reais
